# Responses API-compatible LLM
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=gpt-5.6-terra
LLM_BASE_URL=https://www.packyapi.com/v1

# LangSmith tracing
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGSMITH_PROJECT=agentic-us-equity-research

# PostgreSQL used by LangGraph persistence and Web users
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=replace-with-your-postgres-user
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_DATABASE=trading
# Per-worker PostgreSQL connection pool
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_TIMEOUT_SECONDS=30

# 32+ random characters used to sign 30-minute access tokens
JWT_SECRET=replace-with-at-least-32-random-characters

# Deterministic backtest defaults (costs use basis points)
DEFAULT_TRANSACTION_COST_BPS=5
DEFAULT_SLIPPAGE_BPS=5
DEFAULT_POSITION_TRANCHES=5
