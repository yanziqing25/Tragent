# OpenAI-compatible chat model
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=gpt-5.6-terra
LLM_BASE_URL=https://cc-vibe.com/v1
LLM_REQUEST_TIMEOUT_SECONDS=180

# SiliconFlow embeddings used by LangGraph PostgresStore semantic search
EMBEDDING_API_KEY=replace-with-your-siliconflow-api-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_DIMENSIONS=1024

# Required by the SEC fair-access policy, e.g. "Your Name your-email@example.com"
SEC_USER_AGENT=replace-with-your-name-and-email

# LangSmith tracing
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGSMITH_PROJECT=agentic-us-equity-research

# PostgreSQL used by LangGraph persistence and Web users
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=replace-with-your-postgres-user
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_DATABASE=trading
# PostgreSQL connection pool per process. A worker's runs share its pool and each running task
# holds one connection for its lock, so keep the maximum at least twice the worker concurrency.
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=32
POSTGRES_POOL_TIMEOUT_SECONDS=30

# Redis: Celery broker for Agent runs and the live progress channel
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=replace-with-your-redis-password
REDIS_DATABASE=0
# Queued or running research tasks one user may have at a time
MAX_ACTIVE_RUNS_PER_USER=2

# Kafka: order commands to the broker process and order events back to the API
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# SeaweedFS (S3-compatible) for research artifacts, statements, and exports; compose starts it
# with these credentials
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=replace-with-an-access-key
S3_SECRET_KEY=replace-with-a-secret-key
S3_BUCKET=tragent

# 32+ random characters used to sign 30-minute access tokens
JWT_SECRET=replace-with-at-least-32-random-characters
# Web origins allowed to call the API from another domain (JSON list); the Vite dev
# server proxies /api, so local development needs none
CORS_ORIGINS=["https://your-web-app.example"]

# Deterministic backtest defaults (costs use basis points)
DEFAULT_TRANSACTION_COST_BPS=5
DEFAULT_SLIPPAGE_BPS=5
DEFAULT_POSITION_TRANCHES=5
